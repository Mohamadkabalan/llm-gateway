# Copy to .env (git-ignored). `make up` does this for you on first run.

# --- Provider keys (optional; providers without a key are disabled with a warning) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local-only credentials for the compose stack. Change them for anything shared. ---
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard-local-dev
POSTGRES_DB=switchboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=switchboard-local-dev

# --- Host ports (all bound to 127.0.0.1) ---
SB_GATEWAY_PORT=7080
SB_POSTGRES_PORT=7432
SB_REDIS_PORT=7379
SB_PROMETHEUS_PORT=7090
SB_GRAFANA_PORT=7300
# The fake provider, including its control API (/_control/*) for tests and chaos runs.
SB_FAKE_PORT=7800

# --- Gateway ---
# `make secrets` (run by `make up`) fills in both. The pepper keys every stored API-key
# hash: keep it secret, and do not change it (that invalidates every key).
SWITCHBOARD_KEY_PEPPER=
# A virtual key (team "demo", $5/month) created by `make up`; use it as the API key:
# `Authorization: Bearer <key>`, or OPENAI_API_KEY for the OpenAI SDKs.
SWITCHBOARD_DEMO_KEY=
SWITCHBOARD_LOG_LEVEL=info
SWITCHBOARD_LOG_FORMAT=json
# Soft budget alerts (Slack-compatible JSON). Unset: the local fake provider's sink.
# SWITCHBOARD_ALERT_WEBHOOK_URL=
