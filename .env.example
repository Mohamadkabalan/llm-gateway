# Copy to .env (git-ignored). `make up` does this for you on first run.

# --- Provider keys (optional; providers without a key are disabled with a warning) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Local-only credentials for the compose stack. Change them for anything shared. ---
POSTGRES_USER=switchboard
POSTGRES_PASSWORD=switchboard-local-dev
POSTGRES_DB=switchboard
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=switchboard-local-dev

# --- Host ports (all bound to 127.0.0.1) ---
SB_GATEWAY_PORT=7080
SB_POSTGRES_PORT=7432
SB_REDIS_PORT=7379
SB_PROMETHEUS_PORT=7090
SB_GRAFANA_PORT=7300

# --- Gateway ---
SWITCHBOARD_LOG_LEVEL=info
SWITCHBOARD_LOG_FORMAT=json
